# HealthyMilk real SMS OTP provider configuration
# Configure one complete provider integration. HTTP/API acceptance is not proof
# of delivery to a handset; verify delivery in the provider console and with a
# consented test phone. The application never logs OTPs or provider secrets.

# Option 1: Fast2SMS OTP API (India)
# Configure the approved DLT entity, sender and matching OTP template in the
# Fast2SMS account as required for your route/account.
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option 2: Twilio SMS API
# For India, ensure the account, sender and message comply with applicable
# carrier/route registration and DLT requirements.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Option 3: MSG91 SMS API
# Create an approved DLT entity, sender and OTP template in MSG91; the template
# must accept the OTP variable sent by this application.
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here

# Option 4: Custom HTTP Gateway API URL
# Implement the JSON contract {to, phone, otp, message}; successful responses
# must return JSON with success:true, accepted:true, or status accepted/queued/sent.
# Use HTTPS; the optional API key is sent in the X-API-Key header. GET mode is
# intentionally unsupported so OTPs and phone numbers are not put in URLs.
SMS_API_METHOD=POST
SMS_API_URL=https://api.smsprovider.com/send
SMS_API_KEY=your_custom_gateway_api_key_here

# Required MongoDB connection string (MongoDB Atlas or local MongoDB).
# For tests, use a separate database named with a _test suffix.
MONGODB_URI=mongodb://127.0.0.1:27017/healthymilk
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/healthymilk_test

# Required: generate a unique secret for this deployment (for example, with
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long

# Comma-separated trusted browser origins (required in production).
CORS_ORIGINS=https://your-frontend.example
